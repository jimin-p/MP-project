<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA">

    <!-- 1. 상단 앱바 (< 뒤로가기 / 후기 작성) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/topBarReview"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:background="#FFFFFF"
        android:elevation="2dp"
        android:paddingHorizontal="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnBackReview"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="뒤로가기"
            android:focusable="true"
            android:padding="8dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_back_green"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvReviewHeaderTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="후기 작성"
            android:textColor="#1B1B1B"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 2. 스크롤 본문 영역 -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/bottomReviewBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBarReview">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- 대상 학원 요약 카드 -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="14dp"
                app:cardElevation="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tvReviewAcademyCategory"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="#E8F5E9"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="3dp"
                        android:text="수학 · 초등/중등"
                        android:textColor="#2E7D32"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvReviewAcademyName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="상도 바른수학학원"
                        android:textColor="#1B1B1B"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvReviewAcademyMeta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="수강 인증 후 실제 수강생 후기를 남길 수 있어요"
                        android:textColor="#777777"
                        android:textSize="12sp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- STEP 1: 결제 영수증 인증 (필수) -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="14dp"
                app:cardElevation="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="1. 결제내역 영수증 인증 (필수)"
                            android:textColor="#1B1B1B"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvReceiptStatusBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="#F1F3F4"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="3dp"
                            android:text="미인증"
                            android:textColor="#777777"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="결제 영수증 또는 수강 결제내역 화면을 촬영하거나 업로드해야 후기를 작성할 수 있어요."
                        android:textColor="#666666"
                        android:textSize="12sp" />

                    <!-- 업로드한 영수증 미리보기 영역 (업로드 시 표시) -->
                    <FrameLayout
                        android:id="@+id/layoutReceiptPreview"
                        android:layout_width="match_parent"
                        android:layout_height="160dp"
                        android:layout_marginTop="12dp"
                        android:background="#F5F8F6"
                        android:visibility="gone">

                        <ImageView
                            android:id="@+id/ivReceiptPreview"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="업로드된 영수증 이미지"
                            android:scaleType="centerCrop" />

                        <TextView
                            android:id="@+id/btnRemoveReceipt"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="top|end"
                            android:layout_margin="8dp"
                            android:background="#99000000"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="4dp"
                            android:text="삭제"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp" />
                    </FrameLayout>

                    <!-- 촬영 / 파일 업로드 버튼 2개 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnTakeReceiptPhoto"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_marginEnd="8dp"
                            android:layout_weight="1"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:text="📷 영수증 촬영"
                            android:textColor="#2E7D32"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            app:backgroundTint="#E8F5E9"
                            app:cornerRadius="10dp" />

                        <Button
                            android:id="@+id/btnUploadReceiptFile"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_weight="1"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:text="📎 파일 업로드"
                            android:textColor="#FFFFFF"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            app:backgroundTint="#2E7D32"
                            app:cornerRadius="10dp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvReceiptFileName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="선택된 파일 없음"
                        android:textColor="#888888"
                        android:textSize="12sp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- STEP 2: 별점 평가 -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="14dp"
                app:cardElevation="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="2. 수강 만족도 별점"
                        android:textColor="#1B1B1B"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <!-- 별 5개 클릭 영역 -->
                    <LinearLayout
                        android:id="@+id/layoutStarRating"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/ivStar1"
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:layout_marginHorizontal="4dp"
                            android:clickable="true"
                            android:contentDescription="별점 1점"
                            android:focusable="true"
                            android:padding="4dp"
                            android:src="@android:drawable/btn_star_big_off" />

                        <ImageView
                            android:id="@+id/ivStar2"
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:layout_marginHorizontal="4dp"
                            android:clickable="true"
                            android:contentDescription="별점 2점"
                            android:focusable="true"
                            android:padding="4dp"
                            android:src="@android:drawable/btn_star_big_off" />

                        <ImageView
                            android:id="@+id/ivStar3"
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:layout_marginHorizontal="4dp"
                            android:clickable="true"
                            android:contentDescription="별점 3점"
                            android:focusable="true"
                            android:padding="4dp"
                            android:src="@android:drawable/btn_star_big_off" />

                        <ImageView
                            android:id="@+id/ivStar4"
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:layout_marginHorizontal="4dp"
                            android:clickable="true"
                            android:contentDescription="별점 4점"
                            android:focusable="true"
                            android:padding="4dp"
                            android:src="@android:drawable/btn_star_big_off" />

                        <ImageView
                            android:id="@+id/ivStar5"
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:layout_marginHorizontal="4dp"
                            android:clickable="true"
                            android:contentDescription="별점 5점"
                            android:focusable="true"
                            android:padding="4dp"
                            android:src="@android:drawable/btn_star_big_off" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvRatingScoreText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="별점을 선택해 주세요 (0 / 5)"
                        android:textColor="#2E7D32"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- STEP 3: 후기 내용 작성 (2000자 이하) -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="14dp"
                app:cardElevation="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="3. 수강 후기"
                        android:textColor="#1B1B1B"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvReviewLockGuide"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="※ 영수증 업로드 완료 후 후기 입력이 활성화됩니다."
                        android:textColor="#D97706"
                        android:textSize="12sp" />

                    <EditText
                        android:id="@+id/etReviewContent"
                        android:layout_width="match_parent"
                        android:layout_height="180dp"
                        android:layout_marginTop="10dp"
                        android:background="#F8F9FA"
                        android:enabled="false"
                        android:gravity="top|start"
                        android:hint="수업 방식, 강사님 피드백, 시설 등 솔직한 수강 후기를 작성해 주세요. (최대 2,000자)"
                        android:inputType="textMultiLine"
                        android:maxLength="2000"
                        android:padding="12dp"
                        android:textColor="#1B1B1B"
                        android:textColorHint="#9E9E9E"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvReviewCharCount"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="end"
                        android:text="0 / 2,000자"
                        android:textColor="#888888"
                        android:textSize="12sp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- 3. 하단 후기 등록 버튼 -->
    <LinearLayout
        android:id="@+id/bottomReviewBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:elevation="6dp"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <Button
            android:id="@+id/btnSubmitReview"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:enabled="false"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="영수증 인증 후 후기 등록하기"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            app:backgroundTint="#9E9E9E"
            app:cornerRadius="12dp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>